{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "typecheck",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"-s",
				"tsc",
				"-p",
				".",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "typecheck-npm",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"-s",
				"-w",
				".",
				"tsc",
				"--",
				"-p",
				".",
				"--noEmit"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		}
	]
}